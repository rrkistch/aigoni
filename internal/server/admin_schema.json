  "music": {
    "type": "object",
    "label": "音乐",
    "properties": {
      "showInNavbar": {
        "type": "boolean",
        "label": "导航入口"
      },
      "showInSidebar": {
        "type": "boolean",
        "label": "侧栏入口"
      },
      "mode": {
        "type": "string",
        "label": "来源",
        "enum": [
          "local",
          "meting"
        ]
      },
      "volume": {
        "type": "number",
        "label": "音量",
        "min": 0,
        "max": 1
      },
      "playMode": {
        "type": "string",
        "label": "循环",
        "enum": [
          "list",
          "one",
          "random"
        ]
      },
      "showLyrics": {
        "type": "boolean",
        "label": "歌词"
      },
      "meting": {
        "type": "object",
        "label": "外部歌单",
        "properties": {
          "api": {
            "type": "string",
            "label": "接口模板",
            "format": "url"
          },
          "server": {
            "type": "string",
            "label": "平台",
            "enum": [
              "netease",
              "tencent",
              "kugou",
              "xiami",
              "baidu"
            ]
          },
          "type": {
            "type": "string",
            "label": "类型",
            "enum": [
              "song",
              "playlist",
              "album",
              "search",
              "artist"
            ]
          },
          "id": {
            "type": "string",
            "label": "歌单 ID"
          },
          "fallbackApis": {
            "type": "array",
            "label": "备用接口",
            "items": {
              "type": "string",
              "label": "地址",
              "format": "url"
            },
            "maxItems": 5
          }
        },
        "visibleWhen": {
          "mode": "meting"
        }
      },
      "local": {
        "type": "object",
        "label": "本地",
        "properties": {
          "playlist": {
            "type": "array",
            "label": "歌曲",
            "items": {
              "type": "object",
              "label": "歌曲",
              "properties": {
                "name": {
                  "type": "string",
                  "label": "歌名"
                },
                "artist": {
                  "type": "string",
                  "label": "歌手"
                },
                "url": {
                  "type": "string",
                  "label": "音频",
                  "format": "url",
                  "mediaKind": "audio"
                },
                "cover": {
                  "type": "string",
                  "label": "封面",
                  "format": "url",
                  "mediaKind": "image"
                },
                "lrc": {
                  "type": "string",
                  "label": "歌词文本或地址",
                  "mediaKind": "lyrics"
                }
              }
            },
            "maxItems": 200
          }
        },
        "visibleWhen": {
          "mode": "local"
        }
      }
    }
  },
