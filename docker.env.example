# Copy to docker.env. Values are literal: do not add quotes or inline comments.
# Required: use a long random password, e.g. openssl rand -hex 24.
ADMIN_PASSWORD=
ADMIN_PATH=admin

# false for local HTTP testing; set true when accessing through HTTPS.
COOKIE_SECURE=false
FRONTEND_MODE=firefly

# Rebuild on container startup so upgraded theme/source changes take effect.
# Existing successful release remains available during ordinary rebuilds.
FIREFLY_REBUILD_ON_START=true

# Optional private Wiki/AI provider; leave blank to configure later.
WIKI_APIKEY=
WIKI_BASEURL=
WIKI_MODEL=

# Optional machine API and uploads.
AIGONI_API_KEY=
AIGONI_WIKI_ASK_API_ENABLED=false
AIGONI_WIKI_ASK_API_RPM=60
AIGONI_WIKI_AGENT_CONCURRENCY=5
AIGONI_UPLOAD_ALLOWED_EXTS=jpg,jpeg,png,webp,gif
AIGONI_ADMIN_PER_PAGE=20
