---
import {getCollection,render} from "astro:content";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import Markdown from "@/components/common/Markdown.astro";
export async function getStaticPaths(){return (await getCollection("aigoniPages")).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;
const {Content,headings}=await render(entry);
---
<MainGridLayout title={entry.data.title} description={entry.data.description} headings={entry.data.aigoniTOC ? headings : []}>
 <article class="card-base px-6 md:px-9 py-8" data-pagefind-body>
 <h1 class="text-3xl font-bold mb-8">{entry.data.title}</h1><Markdown class="mt-2"><Content /></Markdown>
 </article>
</MainGridLayout>
